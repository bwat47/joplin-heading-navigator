{
    "name": "joplin-plugin-heading-navigator",
    "version": "0.9.4",
    "scripts": {
        "dist": "npm run typecheck && joplin-plugin-scripts build",
        "prepare": "npm run dist",
        "updateVersion": "joplin-plugin-scripts update-version",
        "updateApi": "joplin-plugin-scripts update-api",
        "lint": "oxlint src/ && npm run lint:dead-code && npm run lint:complexity",
        "lint:dead-code": "fallow dead-code",
        "lint:complexity": "fallow health --complexity",
        "lint:fix": "oxlint src/ --fix",
        "format": "oxfmt --write",
        "format:check": "oxfmt --check",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "license": "MIT",
    "engines": {
        "node": ">=22"
    },
    "keywords": [
        "joplin-plugin"
    ],
    "files": [
        "publish"
    ],
    "devDependencies": {
        "@bwat47/joplin-plugin-scripts": "^1.5.0",
        "@codemirror/lang-markdown": "6.5.1",
        "@codemirror/language": "6.12.4",
        "@codemirror/state": "6.5.2",
        "@codemirror/view": "6.38.7",
        "@lezer/common": "^1.5.2",
        "@lezer/markdown": "^1.6.0",
        "@types/node": "^25.9.4",
        "fallow": "^3.43.0",
        "jsdom": "^29.1.1",
        "oxfmt": "^0.78.0",
        "oxlint": "^1.93.0",
        "oxlint-tsgolint": "^7.0.2007",
        "typescript": "^7.0.2",
        "vitest": "^5.0.3"
    },
    "dependencies": {
        "@joplin/fork-uslug": "^2.0.6",
        "entities": "^9.0.0",
        "fuzzysort": "^4.0.2"
    }
}
