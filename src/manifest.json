{
    "manifest_version": 1,
    "id": "com.bwat47.heading-navigator",
    "app_min_version": "3.3",
    "version": "0.9.0",
    "platforms": ["desktop", "mobile"],
    "name": "Heading Navigator",
    "description": "VS Code/Sublime text style overlay panel to navigate through headings (table of contents) in the markdown editor",
    "author": "bwat47",
    "homepage_url": "https://github.com/bwat47/joplin-heading-navigator",
    "repository_url": "https://github.com/bwat47/joplin-heading-navigator",
    "keywords": ["heading", "outline", "keyboard", "navigation", "toc"],
    "categories": ["productivity", "editor"],
    "screenshots": [
        { "src": "images/screenshot1.png", "label": "Heading Navigator screenshot 1" },
        { "src": "images/screenshot2.png", "label": "Heading Navigator screenshot 2" },
        { "src": "images/screenshot3.png", "label": "Heading Navigator screenshot 3" }
    ],
    "icons": {
        "128": "images/128.png",
        "64": "images/64.png",
        "48": "images/48.png",
        "32": "images/32.png",
        "24": "images/24.png",
        "16": "images/16.png"
    },
    "promo_tile": {
        "src": "images/heading-navigator_promo_tile.png",
        "label": "heading Navigator Promo Tile"
    }
}
