{
    "manifest_version": 1,
    "id": "com.bwat47.heading-navigator",
    "app_min_version": "3.3",
    "version": "0.9.4",
    "platforms": ["desktop", "mobile"],
    "name": "Heading Navigator",
    "description": "VS Code/Sublime text style overlay panel to navigate through headings (toc/table of contents) in the markdown editor",
    "author": "bwat47",
    "homepage_url": "https://github.com/bwat47/joplin-heading-navigator",
    "repository_url": "https://github.com/bwat47/joplin-heading-navigator",
    "keywords": ["heading", "outline", "keyboard", "navigation", "toc"],
    "categories": ["productivity", "editor"],
    "screenshots": [
        { "src": "images/screenshot_theme_light.png", "label": "Heading Navigator light theme - heading badge mode" },
        { "src": "images/screenshot_theme_dark.png", "label": "Heading Navigator dark theme - heading badge mode" },
        { "src": "images/screenshot_mobile.png", "label": "Heading Navigator mobile screenshot" },
        { "src": "images/screenshot_full_mode.png", "label": "Heading Navigator screenshot full mode" },
        { "src": "images/screenshot_atx_mode.png", "label": "Heading Navigator screenshot atx mode" },
        { "src": "images/screenshot_none_mode.png", "label": "Heading Navigator screenshot none mode" }
    ],
    "icons": {
        "128": "images/128.png",
        "64": "images/64.png",
        "48": "images/48.png",
        "32": "images/32.png",
        "24": "images/24.png",
        "16": "images/16.png"
    },
    "promo_tile": {
        "src": "images/heading_navigator_promo_tile.png",
        "label": "heading Navigator Promo Tile"
    }
}
